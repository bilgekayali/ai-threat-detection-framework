{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bilgekayali/ai-threat-detection-framework/schemas/alert-input.schema.json",
  "title": "AI Threat Detection Normalized Alert Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "user_id",
    "asset_id",
    "event_type",
    "anomaly_score",
    "off_hours",
    "failed_logins_24h",
    "geo_distance_km",
    "proc_injection_flag",
    "label"
  ],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "user_id": {"type": "integer", "minimum": 0},
    "asset_id": {"type": "integer", "minimum": 0},
    "event_type": {
      "type": "string",
      "enum": ["file", "login", "network", "process", "registry"]
    },
    "anomaly_score": {"type": "number", "minimum": 0, "maximum": 1},
    "off_hours": {"type": "integer", "enum": [0, 1]},
    "failed_logins_24h": {"type": "number", "minimum": 0},
    "geo_distance_km": {"type": "number", "minimum": 0},
    "proc_injection_flag": {"type": "integer", "enum": [0, 1]},
    "label": {"type": "integer", "enum": [0, 1]}
  }
}
